{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
    "Jwt": {
    "Issuer": "SecureWallet",
    "Audience": "SecureWallet.Client",
    "ExpiryMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "WalletLimits": {
    "DailyOutgoingLimit": 100000
  }
}
